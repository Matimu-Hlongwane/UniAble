# API URL used by all app API calls, including account verification. Use the complete /api URL.
# For an iOS Simulator, localhost reaches the Mac running the backend.
# For a physical phone, configure the backend at a reachable HTTPS URL.
# Leave unset to use platform defaults (localhost in iOS Simulator/browser, 10.0.2.2 in Android emulator).
# VITE_API_URL=https://your-api-domain.example/api

# Shared UniAble Firebase web configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Set this only to a verified campus security phone number.
VITE_CAMPUS_SECURITY_PHONE=
# Optional root API URL. VITE_API_URL takes precedence when both are set.
# VITE_API_BASE_URL=https://your-api-domain.example
