# Optional API override. Leave unset for browser (localhost) and Android emulator (10.0.2.2).
# For a physical Android phone, use your computer LAN IP, e.g. http://192.168.1.20:4000/api.
# For production, use your deployed HTTPS API URL.
# VITE_API_URL=

# Shared UniAble Firebase web configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# South African campus/security phone number used by the Peer Assistance button
VITE_CAMPUS_SECURITY_PHONE=112
VITE_API_BASE_URL=http://localhost:4000
